{
    "id": "uk.org.unionz.IrregularTuningMaker",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.8",
    "sdk": "org.kde.Sdk",
    "command": "IrregularTuningMaker",

    "rename-desktop-file": "IrregularTuningMaker.desktop",
    "rename-icon": "icon",

    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=home"
    ],

    "modules": [
        {
            "name": "IrregularTuningMaker",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "."
                }
            ]
        }
    ]
}

